# Local Niche Opportunity Scorer — environment template
# Copy to .env (gitignored) for local dev, or use Streamlit Secrets in deploy.
# NEVER commit real keys.

# FRED — required for the brief snapshot current-data layer (§4 D4).
FRED_API_KEY=

# Census ACS — works without a key at low volume; add one to lift rate limits.
CENSUS_API_KEY=

# Section 2–4 LLM generation.
ANTHROPIC_API_KEY=

# Google Programmable Search (employer/sector context for section 2; §4.3
# marketing context only). CX is the search engine id (not secret); KEY is.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=13d04e872f34645c6

# Optional: override the on-disk cache location (default: ./.cache).
LNOS_CACHE_DIR=
